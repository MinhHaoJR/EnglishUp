<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>27d107c0-2db4-44c8-a8eb-ee32d8418224</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
  </ItemGroup>

  <!-- The client's bundled learning content is the single source for game questions and the RAG assistant. -->
  <ItemGroup>
    <Content Include="..\..\src\data\vocabulary.json;..\..\src\data\vocabulary-it.json;..\..\src\data\reading.json;..\..\src\data\listening.json;..\..\src\data\writing.json;..\..\src\data\structures.json" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
